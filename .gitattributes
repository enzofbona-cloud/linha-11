* text=auto eol=lf
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text

# New small game assets use ordinary Git to avoid LFS quotas.
assets/models/polyhaven/**/*.gltf -filter diff text
assets/models/polyhaven/**/*.bin -filter -diff -merge -text
assets/models/polyhaven/**/*.jpg -filter -diff -merge -text
assets/models/furniture/*.glb -filter -diff -merge -text
assets/models/props/*.glb -filter -diff -merge -text
assets/textures/floor_aged/*.jpg -filter -diff -merge -text
assets/textures/wall_aged/*.jpg -filter -diff -merge -text
assets/textures/creature_hide/*.jpg -filter -diff -merge -text
# Original frame art is small and stays in ordinary Git (no LFS quota).
assets/textures/frames/*.png -filter -diff -merge -text
assets/textures/frames/*.svg -filter -diff -merge -text
assets/models/characters/*.glb -filter -diff -merge -text
assets/models/characters/*.jpg -filter -diff -merge -text
assets/models/characters/*.png -filter -diff -merge -text
# Small menu artwork stays in ordinary Git too.
assets/ui/*.png -filter -diff -merge -text
